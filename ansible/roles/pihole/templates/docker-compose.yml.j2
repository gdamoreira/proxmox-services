services:
  pihole:
    image: pihole/pihole:latest
    container_name: pihole
    restart: unless-stopped
    ports:
      - "53:53/tcp"
      - "53:53/udp"
      - "{{ pihole_port }}:80/tcp"
    volumes:
      - {{ pihole_data_dir }}/etc-pihole:/etc/pihole
      - {{ pihole_data_dir }}/etc-dnsmasq.d:/etc/dnsmasq.d
    environment:
      - TZ={{ timezone }}
      - WEBPASSWORD={{ pihole_password }}
      - PIHOLE_DNS_={{ pihole_dns }}
