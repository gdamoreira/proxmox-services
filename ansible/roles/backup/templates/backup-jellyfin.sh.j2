#!/bin/bash
set -euo pipefail

BACKUP_BASE="{{ backup_mount }}/{{ backup_cifs_base }}/jellyfin"
DATE=$(date +%Y-%m-%d-%H%M%S)
TMPDIR=$(mktemp -d)

trap 'rm -rf "$TMPDIR"' EXIT

echo "=== Jellyfin backup $DATE ==="

echo "Copying config..."
cp -r {{ jellyfin_data_dir }}/config "$TMPDIR/config" 2>/dev/null || true

echo "Creating archive..."
mkdir -p "$BACKUP_BASE"
ARCHIVE="$BACKUP_BASE/jellyfin-backup-$DATE.tar.gz"
tar czf "$ARCHIVE" -C "$TMPDIR" .

echo "=== Jellyfin backup complete: $ARCHIVE ==="
