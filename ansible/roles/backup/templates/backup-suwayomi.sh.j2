#!/bin/bash
set -euo pipefail

BACKUP_BASE="{{ backup_mount }}/{{ backup_cifs_base }}/suwayomi"
COMPOSE_DIR="{{ suwayomi_compose_dir }}"
DATE=$(date +%Y-%m-%d-%H%M%S)

echo "=== Suwayomi backup $DATE ==="
mkdir -p "$BACKUP_BASE"

# Database (logical, custom format)
DUMP="/tmp/suwayomi-db-$DATE.dump"
echo "Dumping PostgreSQL database..."
docker compose -f "$COMPOSE_DIR/docker-compose.yml" exec -T postgresql \
  pg_dump -Fc -U {{ suwayomi_pg_user }} -d {{ suwayomi_pg_db }} > "$DUMP"
if [ ! -s "$DUMP" ]; then
  echo "ERROR: pg_dump produced an empty file"
  rm -f "$DUMP"
  exit 1
fi
cp "$DUMP" "$BACKUP_BASE/"
(cd "$BACKUP_BASE" && sha256sum "$(basename "$DUMP")" > "$(basename "$DUMP").sha256")
rm -f "$DUMP"

# Config/data (exclude downloads, legacy H2 files, built-in backups)
CFG="/tmp/suwayomi-config-$DATE.tar.gz"
echo "Archiving $COMPOSE_DIR files (excluding downloads, H2 db, built-in backups)..."
tar czf "$CFG" --warning=no-file-changed \
  --exclude='files/downloads' \
  --exclude='files/database.mv.db*' \
  --exclude='files/database.*.sql' \
  --exclude='files/backups' \
  -C {{ suwayomi_data_dir }} files 2>/dev/null || true
if [ ! -s "$CFG" ]; then
  echo "ERROR: config archive is empty"
  rm -f "$CFG"
  exit 1
fi
cp "$CFG" "$BACKUP_BASE/"

rm -f "$DUMP" "$CFG"

echo "=== Suwayomi backup complete ($(ls -1 "$BACKUP_BASE" | wc -l) files in $BACKUP_BASE) ==="
