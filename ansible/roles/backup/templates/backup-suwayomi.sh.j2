#!/bin/bash
set -euo pipefail

BACKUP_BASE="{{ backup_mount }}/{{ backup_cifs_base }}/suwayomi"
DATE=$(date +%Y-%m-%d-%H%M%S)
ARCHIVE="/tmp/suwayomi-files-$DATE.tar.gz"

echo "=== Suwayomi backup $DATE ==="

echo "Archiving /var/suwayomi/files (excluding downloads)..."
tar czf "$ARCHIVE" --exclude='downloads' --warning=no-file-changed -C /var/suwayomi files 2>/dev/null || true

echo "Storing to $BACKUP_BASE..."
mkdir -p "$BACKUP_BASE"
cp "$ARCHIVE" "$BACKUP_BASE/suwayomi-files-$DATE.tar.gz"

rm -f "$ARCHIVE"

echo "=== Suwayomi backup complete ==="