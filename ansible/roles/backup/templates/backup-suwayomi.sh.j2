#!/bin/bash
set -euo pipefail

BACKUP_DIR="server-backups/suwayomi"
DATE=$(date +%Y-%m-%d-%H%M%S)
ARCHIVE="/tmp/suwayomi-files-$DATE.tar.gz"

echo "=== Suwayomi backup $DATE ==="

echo "Archiving /var/suwayomi/files (excluding downloads)..."
tar czf "$ARCHIVE" --exclude='downloads' -C /var/suwayomi files

echo "Uploading to {{ backup_cifs_server }}/{{ backup_cifs_share }}/$BACKUP_DIR..."
smbclient "{{ backup_cifs_server }}/{{ backup_cifs_share }}" \
  -U "{{ backup_cifs_username }}%{{ backup_cifs_password }}" \
  -c "cd server-backups; mkdir suwayomi; cd suwayomi; put \"$ARCHIVE\" \"suwayomi-files-$DATE.tar.gz\"" 2>&1 || true

rm -f "$ARCHIVE"

echo "=== Suwayomi backup complete ==="