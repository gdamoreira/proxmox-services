#!/bin/bash
set -euo pipefail

BACKUP_BASE="{{ backup_cifs_mount }}/mangareader"
DATE=$(date +%Y-%m-%d-%H%M%S)
BACKUP_DIR="$BACKUP_BASE/$DATE"
TMPDIR=$(mktemp -d)

trap 'rm -rf "$TMPDIR"' EXIT

mkdir -p "$BACKUP_DIR"

echo "=== Mangareader backup $DATE ==="

# Copy config and DB from container
echo "Copying config and database..."
docker cp mangareader:/app/data/suwayomi-server.mv.db "$TMPDIR/" 2>/dev/null || true
docker cp mangareader:/app/data/server.json "$TMPDIR/" 2>/dev/null || true
docker cp mangareader:/app/data/application.conf "$TMPDIR/" 2>/dev/null || true

# Create archive
echo "Creating archive..."
tar czf "$BACKUP_DIR/mangareader-backup-$DATE.tar.gz" -C "$TMPDIR" .

# Retention: keep last {{ backup_retention_days }} days
echo "Cleaning backups older than {{ backup_retention_days }} days..."
find "$BACKUP_BASE" -mindepth 1 -maxdepth 1 -type d -mtime +{{ backup_retention_days }} -exec rm -rf {} \; 2>/dev/null || true

echo "=== Mangareader backup complete: $BACKUP_DIR/mangareader-backup-$DATE.tar.gz ==="
