#!/bin/bash
set -euo pipefail

BACKUP_BASE="{{ backup_mount }}/{{ backup_cifs_base }}/immich"
DATE=$(date +%Y-%m-%d-%H%M%S)
TMPDIR=$(mktemp -d)

trap 'rm -rf "$TMPDIR"' EXIT

echo "=== Immich backup $DATE ==="

echo "Dumping postgres database..."
docker exec immich_postgres pg_dump -U postgres immich > "$TMPDIR/immich.sql"

echo "Creating archive..."
mkdir -p "$BACKUP_BASE"
ARCHIVE="$BACKUP_BASE/immich-backup-$DATE.tar.gz"
tar czf "$ARCHIVE" -C "$TMPDIR" .

echo "=== Immich backup complete: $ARCHIVE ==="
