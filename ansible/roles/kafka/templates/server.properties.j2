# KRaft mode (no Zookeeper)
process.roles=broker,controller
node.id={{ kafka_node_id }}
controller.quorum.voters={{ kafka_node_id }}@{{ kafka_ip }}:{{ kafka_controller_port }}

# Listeners
listeners=BROKER://0.0.0.0:{{ kafka_port }},CONTROLLER://0.0.0.0:{{ kafka_controller_port }}
advertised.listeners=BROKER://{{ kafka_ip }}:{{ kafka_port }}
listener.security.protocol.map=BROKER:PLAINTEXT,CONTROLLER:PLAINTEXT
inter.broker.listener.name=BROKER
controller.listener.names=CONTROLLER

# Storage
log.dirs={{ kafka_data_dir }}

# Partitions and replication
num.partitions=3
default.replication.factor=1
offsets.topic.replication.factor=1
transaction.state.log.replication.factor=1
transaction.state.log.min.isr=1

# Log retention
log.retention.hours=168
log.segment.bytes=1073741824
log.retention.check.interval.ms=300000

# Network
socket.send.buffer.bytes=102400
socket.receive.buffer.bytes=102400
socket.request.max.bytes=104857600

# Auto topic creation
auto.create.topics.enable=true
delete.topic.enable=true

# Metrics
metric.reporters=
