[Unit]
Description=Apache Kafka (KRaft mode)
Documentation=https://kafka.apache.org/documentation/
After=network.target

[Service]
Type=simple
User={{ kafka_user }}
Group={{ kafka_group }}
Environment="KAFKA_HEAP_OPTS={{ kafka_heap_opts }}"
Environment="LOG_DIR={{ kafka_log_dir }}"
ExecStart={{ kafka_bin_dir }}/bin/kafka-server-start.sh {{ kafka_bin_dir }}/config/server.properties
ExecStop={{ kafka_bin_dir }}/bin/kafka-server-stop.sh
Restart=on-failure
RestartSec=10
LimitNOFILE=100000

[Install]
WantedBy=multi-user.target
